<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration minimale : fenêtres principales maximisées et sans bordure. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
  </keyboard>
  <mouse>
    <context name="Root"></context>
  </mouse>
  <applications>
    <application class="*" type="normal">
      <decor>no</decor>
      <maximized>true</maximized>
    </application>
  </applications>
</openbox_config>
