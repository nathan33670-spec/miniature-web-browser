# =============================================================================
#  Navigateur distant — configuration
#  Copiez ce fichier :  cp .env.example .env   puis adaptez les valeurs.
# =============================================================================

# -----------------------------------------------------------------------------
# Réseau
# -----------------------------------------------------------------------------
# Port publié sur le NAS (https://IP-DU-NAS:8443), en IPv4 uniquement.
GATEWAY_PORT=8443

# Refuse toute connexion entrante IPv6 (y compris relayée par un reverse proxy).
IPV4_ONLY=true

# -----------------------------------------------------------------------------
# Authentification (OBLIGATOIRE)
# -----------------------------------------------------------------------------
AUTH_USERNAME=admin

# Hash du mot de passe. Générez-le avec :
#   docker compose run --rm --no-deps -it gateway hash-password
AUTH_PASSWORD_HASH=

# Double authentification TOTP (fortement recommandé). Générez la clé avec :
#   docker compose run --rm --no-deps gateway generate-totp
# Laissez vide pour la désactiver.
TOTP_SECRET=

# Durée maximale d'une session (heures) et déconnexion après inactivité (minutes).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Anti-bruteforce : N échecs en LOGIN_WINDOW_MINUTES => IP bloquée LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Restriction par adresse IP (optionnelle)
# -----------------------------------------------------------------------------
# true  => seules les IP ci-dessous (+ celles toujours autorisées) peuvent même
#          afficher la page de connexion. Les autres reçoivent un 403.
# false => tout le monde peut atteindre la page de connexion (mot de passe requis).
IP_RESTRICTION_ENABLED=false

# IP ou réseaux CIDR IPv4 autorisés, séparés par des virgules.
# Exemple : IP_ALLOWLIST=81.250.12.34, 92.184.0.0/16
IP_ALLOWLIST=

# --- Toujours autorisés, même avec la restriction active : ---
#  * localhost (127.0.0.1, ::1)
#  * la passerelle Docker = le NAS lui-même (détectée automatiquement)
#  * les IP du NAS listées ci-dessous
#  * l'IP publique de la box/serveur (détectée automatiquement), donc tout
#    appareil de votre réseau qui sort par cette même IP publique.

# IP locales du NAS (ex. 192.168.1.10). Séparées par des virgules.
NAS_IPS=

# Autoriser la passerelle réseau Docker (= requêtes venant du NAS lui-même).
TRUST_DOCKER_GATEWAY=true

# Autoriser l'IP publique sur laquelle est hébergé le serveur.
ALLOW_SERVER_PUBLIC_IP=true
# Détection automatique de cette IP (rafraîchie toutes les N minutes).
PUBLIC_IP_AUTODETECT=true
PUBLIC_IP_REFRESH_MINUTES=10
# IP publique fixe (si connue) et/ou nom DynDNS résolu périodiquement.
SERVER_PUBLIC_IP=
SERVER_PUBLIC_HOSTNAMES=
# Services de détection (facultatif, une IP en texte brut par réponse).
# PUBLIC_IP_DETECT_URLS=https://api.ipify.org,https://ipv4.icanhazip.com,https://v4.ident.me

# -----------------------------------------------------------------------------
# Reverse proxy (facultatif)
# -----------------------------------------------------------------------------
# Si vous placez un reverse proxy devant (Synology, Nginx Proxy Manager,
# Traefik…), indiquez son IP vue depuis le conteneur pour que l'IP réelle du
# client (X-Forwarded-For) soit utilisée. Sinon, laissez vide : l'en-tête est ignoré.
# Exemple (reverse proxy du NAS) : TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# HTTPS
# -----------------------------------------------------------------------------
# self-signed : certificat auto-généré dans ./data/gateway/tls (par défaut)
# custom      : vos certificats (TLS_CERT_FILE / TLS_KEY_FILE, montés dans /data)
# off         : HTTP simple — uniquement derrière un reverse proxy HTTPS !
TLS_MODE=self-signed
TLS_COMMON_NAME=remote-browser
# TLS_CERT_FILE=/data/tls/fullchain.pem
# TLS_KEY_FILE=/data/tls/privkey.pem

# Cookie "Secure" : auto (selon HTTPS), true ou false.
COOKIE_SECURE=auto

# -----------------------------------------------------------------------------
# Navigateur Chromium (conteneur "desktop")
# -----------------------------------------------------------------------------
# Utilisateur/groupe propriétaires de ./data/desktop sur le NAS (commande `id`).
PUID=1000
PGID=1000
TZ=Europe/Paris
BROWSER_LOCALE=fr_FR.UTF-8
# Page d'accueil.
START_URL=https://www.google.fr
# Taille de l'écran au démarrage ; elle s'adapte ensuite à votre fenêtre.
SCREEN_RESOLUTION=1600x900
# Options supplémentaires passées à Chromium (facultatif).
CHROMIUM_FLAGS=
# Mot de passe VNC interne entre guacd et le bureau (défense en profondeur).
# Mettez une chaîne aléatoire : openssl rand -hex 32  (seuls 8 caractères sont
# utilisés par le protocole VNC ; le bureau n'est de toute façon pas exposé).
INTERNAL_BROWSER_PASSWORD=
# Image guacd (épinglez une version si vous le souhaitez).
# GUACD_IMAGE=guacamole/guacd:1.6.0

# debug | info | warn | error
LOG_LEVEL=info
